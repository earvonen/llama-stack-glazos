# GLAZOS — G GitHub, L Linux, A Ansible, Z Zabbix, O OpenShift, S Satellite
# Copy to .env in the project root and fill in values.
# deploy-openshift.sh sources this file and applies Kubernetes Secrets/ConfigMaps.
# Do not commit .env (it is gitignored).

# --- Llama Stack / inference ---
VLLM_URL=https://llm.example.com/v1
VLLM_API_TOKEN=fake
TAVILY_SEARCH_API_KEY=

# --- In-cluster MCP URLs (Llama Stack connector / tool group endpoints) ---
MCP_GITHUB_SSE_URL=http://github-mcp:8080/
MCP_OPENSHIFT_SSE_URL=http://kubernetes-mcp:8080/sse
MCP_AAP_PROXY_BASE_URL=http://aap-mcp-proxy:8080
MCP_LINUX_URL=http://linux-mcp:8080/mcp
MCP_SATELLITE_URL=http://satellite-mcp:8080/mcp/sse
MCP_ZABBIX_URL=http://zabbix-mcp:8080/mcp

# --- External AAP MCP (nginx proxy upstream) ---
AAP_MCP_BASE_URL=https://aap.example.com
AAP_MCP_HOST=aap.example.com
AAP_MCP_TOKEN=

# --- GitHub MCP (raw PAT — no "Bearer " prefix) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Linux MCP (Red Hat linux-mcp-server) ---
LINUX_MCP_USER=
LINUX_MCP_KEY_PASSPHRASE=
LINUX_MCP_SSH_KEY_FILE=
LINUX_MCP_SSH_CONFIG_FILE=

# --- Satellite MCP (external Foreman/Satellite API) ---
SATELLITE_URL=https://satellite.example.com
FOREMAN_USERNAME=
FOREMAN_TOKEN=
SATELLITE_CA_FILE=

# --- Zabbix MCP (external Zabbix API) ---
ZABBIX_URL=https://zabbix.example.com
ZABBIX_API_TOKEN=
ZABBIX_MCP_AUTH_TOKEN=
